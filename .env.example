# 로컬 개발용 환경변수 예시.
# 이 파일을 .env 로 복사해 값을 채우면 서버가 자동으로 읽는다 (application.properties의 spring.config.import).
# .env 는 .gitignore 에 들어 있으므로 커밋되지 않는다. 운영 서버에서는 실제 환경변수로 설정할 것.

# ── DB (MariaDB) ─────────────────────────────────────────────
DB_URL=jdbc:mariadb://localhost:3306/ecotvy
DB_USERNAME=root
# 필수 (기본값 없음). 비어 있으면 서버 시작 시 DB 접속 오류가 난다
DB_PASSWORD=
# 로컬은 update, 운영은 validate(또는 none) 권장
DB_DDL_AUTO=update

# ── Redis ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── S3 (사진 저장) ───────────────────────────────────────────
AWS_S3_BUCKET=ecotvy-images
AWS_REGION=ap-northeast-2
# 자격 증명: 로컬은 키로, 운영(EC2/ECS 등)은 키 대신 IAM 역할을 권장 (그때는 이 두 줄을 비워 둔다)
# 필요한 권한: s3:PutObject, s3:GetObject, s3:DeleteObject (해당 버킷)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 호환 저장소(MinIO, LocalStack 등)를 쓸 때만 지정. 비우면 AWS S3
AWS_S3_ENDPOINT=
# 화면에 내려가는 사진 서명 URL의 유효기간 (최대 7d)
AWS_S3_PRESIGNED_URL_TTL=1h

# ── 메일(SMTP): 비밀번호 재설정 메일 발송 ─────────────────────────
# 비워 두면 메일 기능이 꺼진다 (서버는 정상 기동, 관리자 초기화는 계속 사용 가능)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
# Gmail이면 계정 비밀번호가 아니라 "앱 비밀번호"(Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호)
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# 보내는 사람 주소 (비우면 MAIL_USERNAME)
MAIL_FROM=

# 예) Gmail
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# 예) 로컬 테스트용 Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) — 실제로 발송되지 않음
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false

# ── 그 밖의 설정 ─────────────────────────────────────────────
# JWT 서명 키 (필수, 32바이트 이상): openssl rand -base64 48
JWT_SECRET=
# 메일 링크가 가리킬 프론트엔드 주소
FRONTEND_BASE_URL=http://localhost:5173
# 프론트엔드 Origin (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173
